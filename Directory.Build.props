<Project>
  <!--
    Shared MSBuild settings for every .NET project in the repository (contracts, backend, worker, tests).
    Keeping these in one place guarantees the backend and worker compile under identical rules, which
    matters because they exchange Temporal payloads through the shared Oregon.Contracts assembly.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Code quality: analyzers + IDE style rules from .editorconfig are enforced at build time. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Vulnerability advisories stay visible as warnings but never break a local build unexpectedly.
         CI should run the NuGet vulnerability audit ("dotnet list package" with the vulnerable flag). -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- The containers run on chiseled Ubuntu images without ICU; nothing in the app needs culture data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Test projects: doc generation stays on (the IDE0005 unused-using check needs it) but missing XML
       comments are not required there, and tests are never packaged. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
</Project>
