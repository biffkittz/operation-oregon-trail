# Template for infra/.secrets/secrets.env (git-ignored, docker-ignored). Copy, fill in, then before Terraform:
#   cp infra/secrets.env.example infra/.secrets/secrets.env && chmod 600 infra/.secrets/secrets.env
#   source infra/.secrets/secrets.env
#
# Every TF_VAR_* below feeds an *ephemeral* Terraform variable: the values are written to Key Vault through
# write-only attributes and never appear in Terraform state or plan files.
#
# Use SINGLE quotes. Inside double quotes bash rewrites $, `, \ and ! (a password like "a$b" silently becomes
# "a"). If a value contains a single quote, write it as '\'' (for example 'it'\''s').

# Azure subscription (az account show --query id -o tsv)
export ARM_SUBSCRIPTION_ID=''

# Cloudflare API token with Zone:Read, DNS:Edit and Zone Settings:Edit on biffkittz.com
export CLOUDFLARE_API_TOKEN=''

# The single shared password players type on the login screen
export TF_VAR_app_login_password=''

# Google Gemini API key (worker only)
export TF_VAR_gemini_api_key=''

# Temporal Cloud API key for namespace oregon.joqqs (web + worker)
export TF_VAR_temporal_api_key=''

# Password protecting infra/.secrets/biffkittz-origin.pfx
export TF_VAR_origin_certificate_password=''
