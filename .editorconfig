# Root EditorConfig for the oregon repository.
# C# rules encode the team guidelines (Allman braces, var only when apparent, file-scoped namespaces,
# explicit accessibility, expression-bodied one-liners). They are enforced at build time through
# <EnforceCodeStyleInBuild> in Directory.Build.props.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{tf,tfvars,hcl}]
indent_size = 2

#### .NET / C# style ####
[*.cs]
# Usings: System first, outside the namespace, file-scoped namespaces.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# Braces on new lines for everything (Allman).
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:warning

# 'var' only when the type is apparent from the right-hand side.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

# Target-typed new when the type is clear: List<int> items = new();
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_diagnostic.IDE0090.severity = warning

# Expression-bodied members for simple one-liners.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Explicit accessibility, readonly where possible. Interface members are implicitly public in C#, so the
# conventional "for_non_interface_members" avoids redundant 'public' noise inside interfaces.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning

# Null-safety helpers and modern patterns.
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_prefer_auto_properties = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Unused usings must go.
dotnet_diagnostic.IDE0005.severity = warning

# Naming: PascalCase types/members, _camelCase private fields, I-prefixed interfaces.
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.private_field_symbols.required_modifiers =
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constant_symbols
dotnet_naming_rule.constants_pascal.style = pascal_style
dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.required_modifiers = const
dotnet_naming_style.pascal_style.capitalization = pascal_case

# The const rule must win over the private-field rule.
dotnet_naming_rule.constants_pascal.priority = 1
dotnet_naming_rule.private_fields_underscore.priority = 2

# Static readonly fields are treated like constants (PascalCase).
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_symbols
dotnet_naming_rule.static_readonly_pascal.style = pascal_style
dotnet_naming_rule.static_readonly_pascal.priority = 1
dotnet_naming_symbols.static_readonly_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_symbols.required_modifiers = static, readonly

#### Analyzer tuning (each exception is deliberate) ####
# CA1848/CA1873: we use [LoggerMessage] source generators where logging is hot; ad-hoc logs elsewhere are fine.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion
# CA2007 (ConfigureAwait): the backend and worker are applications with no SynchronizationContext, and
# Temporal *workflow* code must never call ConfigureAwait(false) because it breaks deterministic scheduling.
dotnet_diagnostic.CA2007.severity = none
# CA1812: internal classes instantiated via DI / reflection (Temporal, EF Core) are flagged as "never used".
dotnet_diagnostic.CA1812.severity = none
# CA1515: app projects intentionally expose public types to Temporal/xUnit reflection.
dotnet_diagnostic.CA1515.severity = none
# CA1711: "Activities" / "Exception" suffixes are domain names here.
dotnet_diagnostic.CA1711.severity = none

# EF Core migrations are generated code.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.CA1861.severity = none

# Test code: descriptive method names with underscores are idiomatic; xUnit discovers public classes.
[**/*.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA2000.severity = none
