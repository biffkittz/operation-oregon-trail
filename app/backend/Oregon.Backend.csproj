<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    ASP.NET Core backend: serves the built Vue SPA, exposes the JSON API and SignalR hub, owns the Postgres read
    model, and hosts a small Temporal activity worker (task queue "oregon-web") for read-model projections.
  -->
  <PropertyGroup>
    <RootNamespace>Oregon.Backend</RootNamespace>
    <AssemblyName>Oregon.Backend</AssemblyName>
    <UserSecretsId>oregon-backend</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Temporalio.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/Oregon.Contracts/Oregon.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oregon.Backend.Tests" />
  </ItemGroup>
</Project>
