{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Temporalio": "Information"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Oregon": ""
  },
  "Auth": {
    "Password": "",
    "SessionHours": 12
  },
  "Temporal": {
    "Address": "localhost:7233",
    "Namespace": "default",
    "ApiKey": "",
    "GameTaskQueue": "oregon-game",
    "WebTaskQueue": "oregon-web",
    "RunWebWorker": true,
    "UpdateTimeoutSeconds": 75,
    "QueryTimeoutSeconds": 5
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Proxy": {
    "TrustCloudflareHeaders": false
  }
}
